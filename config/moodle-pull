#!/bin/sh
# Replaces default git pull in the Moodle container: skip-worktree + remove blocks/ues_people
# so merge succeeds (name clash with block_lsu_people); then merges main repo.
# Usage: moodle-pull [remote [branch]]   (default: origin develop)
set -e

REMOTE="${1:-origin}"
BRANCH="${2:-develop}"

cd /var/www/html || exit 1

git config --add safe.directory /var/www/html 2>/dev/null || true
git ls-files blocks/ues_people 2>/dev/null | xargs -r git update-index --skip-worktree 2>/dev/null || true
rm -rf blocks/ues_people
git fetch "$REMOTE" "$BRANCH"
git merge "$REMOTE/$BRANCH"
git ls-files blocks/ues_people 2>/dev/null | xargs -r git update-index --skip-worktree 2>/dev/null || true
rm -rf blocks/ues_people
git update-index --skip-worktree config.php 2>/dev/null || true
echo "Done. Main repo updated."
